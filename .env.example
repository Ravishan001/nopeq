# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Your live site address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://nopeq.com

# ---- Notifications (server-only secrets: NEVER prefix with NEXT_PUBLIC_) ----
# Supabase → Project Settings → API Keys → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
# Push notifications (generate: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email (resend.com → API Keys). EMAIL_FROM must use a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM=NopeQ <bookings@nopeq.com>
# Any long random string; also put it in supabase/cron_reminders.sql
CRON_SECRET=
